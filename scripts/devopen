#!/bin/bash
# devopen — clone a repo, start its devcontainer, and open a VS Code window.
# Usage: devopen <repo-url> [-b branch]
# Installed to /usr/local/bin/devopen by install.py.
set -euo pipefail

CONFIG="${DEVOPEN_CONFIG:-$HOME/.devopen/config.json}"
if [ ! -f "$CONFIG" ]; then
  echo "devopen is not installed. Run:" >&2
  echo "  curl -fsSL https://raw.githubusercontent.com/nickbrett1/devopen/main/install.py | python3" >&2
  exit 1
fi

INSTALL_DIR="$(python3 - "$CONFIG" <<'EOF'
import json, sys
with open(sys.argv[1]) as f:
    print(json.load(f)["install_dir"])
EOF
)"

export PYTHONPATH="$INSTALL_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m devopen "$@"
