#!/bin/bash
# devopen-server — launchd wrapper for the devopen FastAPI server.
# Reads host/port/install_dir from ~/.devopen/config.json and runs uvicorn
# from the project venv. Installed to /usr/local/bin/devopen-server.
set -euo pipefail

CONFIG="${DEVOPEN_CONFIG:-$HOME/.devopen/config.json}"
if [ ! -f "$CONFIG" ]; then
  echo "devopen is not installed. Run:" >&2
  echo "  curl -fsSL https://raw.githubusercontent.com/nickbrett1/devopen/main/install.py | python3" >&2
  exit 1
fi

read -r INSTALL_DIR HOST PORT <<< "$(python3 - "$CONFIG" <<'EOF'
import json, sys
c = json.load(open(sys.argv[1]))
print(c["install_dir"], c.get("host", "0.0.0.0"), c.get("port", 8787))
EOF
)"

export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
cd "$INSTALL_DIR"
exec "$INSTALL_DIR/.venv/bin/python" -m uvicorn devopen.server:app --host "$HOST" --port "$PORT"
